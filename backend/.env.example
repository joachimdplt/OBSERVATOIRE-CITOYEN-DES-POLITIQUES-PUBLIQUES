DATABASE_URL="postgresql://joakmann@localhost:5432/observatoire?schema=public"
SHADOW_DATABASE_URL="postgresql://joakmann@localhost:5432/observatoire_shadow?schema=public"
# Base des tests de bout en bout : vidée à chaque lancement.
TEST_DATABASE_URL="postgresql://joakmann@localhost:5432/observatoire_test?schema=public"

# Signe le cookie de session de l'administration. Long et aléatoire en production.
SESSION_SECRET="change-me"
SESSION_TTL_HOURS=8

# Les fichiers bruts déposés, rangés par empreinte. Jamais servis au public.
STORAGE_DIR="./storage"

PORT=3001
NODE_ENV="development"

# La clé du site public pour lire /api/public (la même dans site/.env)
SITE_API_KEY="change-me"
