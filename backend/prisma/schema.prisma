generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── L'équipe ────────────────────────────────────────────────────────────────
// Le public n'a pas de compte. Seule l'équipe se connecte, pour importer,
// relire et publier.

enum Role {
  editor // déclare, importe, décrit, soumet
  reviewer // relit et tranche, jamais son propre travail
  admin // tout, et les comptes
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  // Un compte retiré ne se connecte plus, mais ses traces restent signées.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  providers    DataProvider[]
  datasets     SourceDataset[]
  indicators   IndicatorDefinition[]
  versions     DatasetVersion[]      @relation("VersionCreatedBy")
  submitted    DatasetVersion[]      @relation("VersionSubmittedBy")
  reviewed     DatasetVersion[]      @relation("VersionReviewedBy")
  reviewEvents ReviewEvent[]

  @@map("users")
}

// ── Les territoires ─────────────────────────────────────────────────────────
// Le référentiel du Code officiel géographique de l'INSEE, par millésime. Une
// commune fusionnée disparaît du millésime suivant mais reste dans celui où
// ses observations ont été publiées : un territoire n'est jamais réécrit.

enum TerritoryLevel {
  country
  region
  department
  commune
  municipal_district // arrondissements de Paris, Lyon et Marseille
}

/**
 * Un millésime du COG chargé, avec la trace de ses fichiers.
 */
model TerritoryVintage {
  year        Int         @id
  // Les fichiers lus : adresse, empreinte SHA-256, date de lecture.
  sources     Json
  importedAt  DateTime    @default(now())
  territories Territory[]

  @@map("territory_vintages")
}

model Territory {
  id             String         @id @default(uuid())
  level          TerritoryLevel
  // Le code du producteur, tel quel : 01001, 2A004, 971, 84.
  code           String
  name           String
  vintage        Int
  regionCode     String?
  departmentCode String?
  // Pour un arrondissement municipal : sa commune.
  communeCode    String?

  territoryVintage TerritoryVintage @relation(fields: [vintage], references: [year])
  observations     Observation[]

  // Le même code désigne une région et un département (84 : Auvergne-Rhône-
  // Alpes et Vaucluse) : un code ne se lit qu'avec son niveau.
  @@unique([level, code, vintage])
  @@map("territories")
}

// ── Le catalogue : qui publie quoi ──────────────────────────────────────────
// Un producteur publie des jeux ; un jeu définit des indicateurs. Le code d'un
// indicateur devient une adresse publique (/indicators/:code) : il ne se
// renomme pas.

enum ProviderKind {
  statistical_service // service statistique ministériel : DREES, DEPP, DARES, SDES
  national_institute // INSEE
  public_operator // RTE, CNAF, OFB…
  other
}

enum Frequency {
  annual
  quarterly
  monthly
  irregular
  one_off
}

/**
 * Les douze piliers. Un pilier est une donnée, jamais un module de code.
 */
enum Pillar {
  agriculture_food
  health
  education_research
  energy
  housing
  transport_infrastructure
  labour_economy_industry
  social_protection
  security_justice_defence
  environment_resources
  institutions_public_services
  culture_sports_associations
}

/**
 * Une agrégation qu'un indicateur permet. Aucune = aucune somme ni moyenne.
 */
enum Aggregation {
  sum
  mean
}

model DataProvider {
  id          String          @id @default(uuid())
  name        String
  acronym     String          @unique
  kind        ProviderKind
  officialUrl String
  createdById String
  createdAt   DateTime        @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  datasets    SourceDataset[]

  @@map("data_providers")
}

model SourceDataset {
  id          String                @id @default(uuid())
  providerId  String
  // L'identifiant du jeu chez son producteur, tel quel.
  producerRef String
  title       String
  url         String
  license     String
  methodology String
  frequency   Frequency
  createdById String
  createdAt   DateTime              @default(now())
  provider    DataProvider          @relation(fields: [providerId], references: [id])
  createdBy   User                  @relation(fields: [createdById], references: [id])
  indicators  IndicatorDefinition[]
  versions    DatasetVersion[]

  @@unique([providerId, producerRef])
  @@map("source_datasets")
}

model IndicatorDefinition {
  id                  String        @id @default(uuid())
  code                String        @unique
  datasetId           String
  label               String
  definition          String
  // Le champ couvert : « écoliers du premier degré », pas « tous les élèves ».
  scope               String
  // L'unité telle que le producteur l'écrit.
  unit                String
  pillar              Pillar
  allowedAggregations Aggregation[]
  method              String
  // Ce que l'indicateur ne dit pas : « pas un nombre de médecins manquants ».
  limits              String
  createdById         String
  createdAt           DateTime      @default(now())
  dataset             SourceDataset @relation(fields: [datasetId], references: [id])
  createdBy           User          @relation(fields: [createdById], references: [id])
  observations        Observation[]

  @@map("indicator_definitions")
}

// ── Les versions d'un jeu et leur lecture ───────────────────────────────────
// Un fichier déposé crée une version. L'ancienne n'est jamais écrasée : on
// garde le fichier brut, son empreinte, et chaque ligne telle qu'elle a été lue.

enum VersionState {
  draft // déposée, en cours de description et de contrôle ; une version rejetée y revient
  in_review // soumise à relecture
  published // visible du public
  superseded // remplacée par une version publiée plus récente
}

enum ReviewAction {
  submitted
  approved
  rejected
  superseded
}

enum SourceFormat {
  csv
  xlsx
}

enum ImportState {
  uploaded // lu, en attente de description des colonnes
  described // colonnes décrites, pas encore contrôlé
  needs_correction // contrôlé, au moins une anomalie bloquante
  validated // contrôlé sans anomalie bloquante, observations prêtes
}

/**
 * Ce qu'une case dit d'une valeur. Une absence n'est jamais un zéro.
 */
enum ObservationStatus {
  documented // une valeur publiée
  not_documented // case vide, « nd », « - » : le producteur ne donne rien
  confidential // « s » : secret statistique
  not_applicable // « so », « sans objet »
}

enum AnomalySeverity {
  blocking // empêche la validation
  info // se lit, ne bloque pas
}

model DatasetVersion {
  id            String        @id @default(uuid())
  datasetId     String
  // Le millésime annoncé par le producteur : « 2024 », « rentrée 2025 ».
  vintage       String
  // L'adresse exacte du fichier chez le producteur.
  fileUrl       String
  collectedAt   DateTime
  fileName      String
  fileHash      String
  fileSize      Int
  state         VersionState  @default(draft)
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  dataset       SourceDataset @relation(fields: [datasetId], references: [id])
  createdBy     User          @relation("VersionCreatedBy", fields: [createdById], references: [id])
  submittedBy   User?         @relation("VersionSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy    User?         @relation("VersionReviewedBy", fields: [reviewedById], references: [id])
  importJob     ImportJob?
  observations  Observation[]

  // Le même fichier ne se dépose pas deux fois pour le même jeu.
  @@unique([datasetId, fileHash])
  @@map("dataset_versions")
}

model ImportJob {
  id          String          @id @default(uuid())
  versionId   String          @unique
  format      SourceFormat
  // Les onglets d'un classeur, et celui qui a été lu.
  sheetNames  String[]
  sheet       String?
  // La ligne qui porte les en-têtes, comptée à partir de 1.
  headerRow   Int             @default(1)
  // La description des colonnes : territoire, période, valeurs (voir domain/import-description.ts).
  description Json?
  validatedAt DateTime?
  rowCount    Int
  state       ImportState     @default(uploaded)
  createdAt   DateTime        @default(now())
  version     DatasetVersion  @relation(fields: [versionId], references: [id])
  rows        RawRow[]
  anomalies   ImportAnomaly[]

  @@map("import_jobs")
}

/**
 * Une ligne du fichier telle qu'elle a été lue : des cases de texte, rien d'interprété.
 */
model RawRow {
  jobId     String
  rowNumber Int
  cells     Json
  job       ImportJob @relation(fields: [jobId], references: [id])

  @@id([jobId, rowNumber])
  @@map("raw_rows")
}

model ImportAnomaly {
  id        String          @id @default(uuid())
  jobId     String
  // La ligne du fichier, comptée à partir de 1 ; vide pour une anomalie qui résume une colonne.
  rowNumber Int?
  column    String?
  kind      String
  severity  AnomalySeverity
  message   String
  job       ImportJob       @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("import_anomalies")
}

// ── Les observations ────────────────────────────────────────────────────────
// Une valeur n'existe qu'attachée à un indicateur, un territoire, une période
// et une version. Une absence garde son statut et n'a pas de valeur.

model Observation {
  id          String              @id @default(uuid())
  indicatorId String
  territoryId String
  // « 2024 », « 2024-T3 », « 2024-03 », « 2025-2026 » (année scolaire).
  period      String
  value       Decimal?            @db.Decimal(20, 6)
  status      ObservationStatus
  versionId   String
  // La ligne du fichier d'où vient la valeur.
  rowNumber   Int
  indicator   IndicatorDefinition @relation(fields: [indicatorId], references: [id])
  territory   Territory           @relation(fields: [territoryId], references: [id])
  version     DatasetVersion      @relation(fields: [versionId], references: [id])

  @@unique([indicatorId, territoryId, period, versionId])
  @@index([indicatorId, versionId])
  @@map("observations")
}

// ── La revue ────────────────────────────────────────────────────────────────
// Chaque soumission, approbation, rejet ou remplacement laisse une trace
// signée : qui, quand, l'état avant, l'état après, pourquoi. Une trace ne se
// modifie ni ne se supprime.

model ReviewEvent {
  id            String       @id @default(uuid())
  actorId       String
  action        ReviewAction
  // L'objet visé : une version de jeu aujourd'hui, une mesure ou un lien demain.
  subjectType   String
  subjectId     String
  before        Json
  after         Json
  justification String?
  at            DateTime     @default(now())
  actor         User         @relation(fields: [actorId], references: [id])

  @@index([subjectType, subjectId])
  @@map("review_events")
}
