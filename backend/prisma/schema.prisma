generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── L'équipe ────────────────────────────────────────────────────────────────
// Le public n'a pas de compte. Seule l'équipe se connecte, pour importer,
// relire et publier.

enum Role {
  editor // déclare, importe, décrit, soumet
  reviewer // relit et tranche, jamais son propre travail
  admin // tout, et les comptes
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  // Un compte retiré ne se connecte plus, mais ses traces restent signées.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  providers            DataProvider[]
  datasets             SourceDataset[]
  indicators           IndicatorDefinition[]
  indicatorSources     IndicatorSource[]     @relation("SourceCreatedBy")
  retiredSources       IndicatorSource[]     @relation("SourceRetiredBy")
  versions             DatasetVersion[]      @relation("VersionCreatedBy")
  submitted            DatasetVersion[]      @relation("VersionSubmittedBy")
  reviewed             DatasetVersion[]      @relation("VersionReviewedBy")
  reviewEvents         ReviewEvent[]
  publications         Publication[]         @relation("PublicationCreatedBy")
  publicationVersions  PublicationVersion[]  @relation("PublicationVersionCreatedBy")
  publicationSubmitted PublicationVersion[]  @relation("PublicationVersionSubmittedBy")
  publicationReviewed  PublicationVersion[]  @relation("PublicationVersionReviewedBy")
  politicalDocuments   PoliticalDocument[]
  candidates           Candidate[]
  programmeSources     ProgrammeSource[]
  topics               Topic[]
  videoChannels        VideoChannel[]
  apiKeys              ApiKey[]
  measures             Measure[]

  @@map("users")
}

// ── Les territoires ─────────────────────────────────────────────────────────
// Le référentiel du Code officiel géographique de l'INSEE, par millésime. Une
// commune fusionnée disparaît du millésime suivant mais reste dans celui où
// ses observations ont été publiées : un territoire n'est jamais réécrit.

enum TerritoryLevel {
  country
  region
  department
  commune
  municipal_district // arrondissements de Paris, Lyon et Marseille
}

/**
 * Un millésime du COG chargé, avec la trace de ses fichiers.
 */
model TerritoryVintage {
  year        Int         @id
  // Les fichiers lus : adresse, empreinte SHA-256, date de lecture.
  sources     Json
  importedAt  DateTime    @default(now())
  territories Territory[]

  @@map("territory_vintages")
}

model Territory {
  id             String         @id @default(uuid())
  level          TerritoryLevel
  // Le code du producteur, tel quel : 01001, 2A004, 971, 84.
  code           String
  name           String
  vintage        Int
  regionCode     String?
  departmentCode String?
  // Pour un arrondissement municipal : sa commune.
  communeCode    String?

  territoryVintage TerritoryVintage @relation(fields: [vintage], references: [year])
  observations     Observation[]

  // Le même code désigne une région et un département (84 : Auvergne-Rhône-
  // Alpes et Vaucluse) : un code ne se lit qu'avec son niveau.
  @@unique([level, code, vintage])
  @@map("territories")
}

// ── Le catalogue : qui publie quoi ──────────────────────────────────────────
// Un producteur publie des jeux ; un jeu définit des indicateurs. Le code d'un
// indicateur devient une adresse publique (/indicators/:code) : il ne se
// renomme pas.

enum ProviderKind {
  statistical_service // service statistique ministériel : DREES, DEPP, DARES, SDES
  national_institute // INSEE
  public_operator // RTE, CNAF, OFB…
  other
}

enum Frequency {
  annual
  quarterly
  monthly
  irregular
  one_off
}

/**
 * Les douze piliers. Un pilier est une donnée, jamais un module de code.
 */
enum Pillar {
  agriculture_food
  health
  education_research
  energy
  housing
  transport_infrastructure
  labour_economy_industry
  social_protection
  security_justice_defence
  environment_resources
  institutions_public_services
  culture_sports_associations
}

/**
 * Ce que donne un indicateur : un nombre (l'APL, des élèves par classe) ou
 * une catégorie d'une liste fermée (le zonage d'une ARS : ZIP, ZAC, HZ).
 */
enum IndicatorKind {
  number
  category
}

/// L'échelle où les valeurs se comparent. Le zonage des médecins se décide
/// région par région, dans des plafonds régionaux : une ZIP de Bretagne et une
/// ZIP d'Occitanie ne sortent pas du même classement, la carte se lit donc
/// une région à la fois.
enum ComparisonScale {
  national
  regional
}

/**
 * Une agrégation qu'un indicateur permet. Aucune = aucune somme ni moyenne.
 */
enum Aggregation {
  sum
  mean
}

model DataProvider {
  id          String          @id @default(uuid())
  name        String
  acronym     String          @unique
  kind        ProviderKind
  officialUrl String
  createdById String
  createdAt   DateTime        @default(now())
  createdBy   User            @relation(fields: [createdById], references: [id])
  datasets    SourceDataset[]

  @@map("data_providers")
}

model SourceDataset {
  id               String            @id @default(uuid())
  providerId       String
  // L'identifiant du jeu chez son producteur, tel quel.
  producerRef      String
  title            String
  url              String
  license          String
  methodology      String
  frequency        Frequency
  createdById      String
  createdAt        DateTime          @default(now())
  provider         DataProvider      @relation(fields: [providerId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  indicatorSources IndicatorSource[]
  versions         DatasetVersion[]

  @@unique([providerId, producerRef])
  @@map("source_datasets")
}

model IndicatorDefinition {
  id                  String             @id @default(uuid())
  code                String             @unique
  label               String
  definition          String
  // Le champ couvert : « écoliers du premier degré », pas « tous les élèves ».
  scope               String
  // L'unité telle que le producteur l'écrit.
  unit                String
  kind                IndicatorKind      @default(number)
  comparisonScale     ComparisonScale    @default(national)
  /// Une couche de la carte, ou un élément de contexte lu seulement dans la
  /// fiche d'une commune (la population par âge, derrière l'APL).
  mapLayer            Boolean            @default(true)
  // Pour une catégorie : la liste fermée [{ code, label }], dans l'ordre de l'arrêté.
  categories          Json?
  pillar              Pillar
  allowedAggregations Aggregation[]
  method              String
  // Ce que l'indicateur ne dit pas : « pas un nombre de médecins manquants ».
  limits              String
  // La lecture en mots simples, reprise du producteur et relue comme le reste.
  // Une question pour titre : « Est-ce facile de voir un généraliste ? »
  question            String?
  // La phrase de lecture du producteur, avec {territoire} et {valeur}.
  readingTemplate     String?
  // Les deux bouts de l'échelle d'un nombre : « accès plus faible », « accès plus élevé ».
  scaleLow            String?
  scaleHigh           String?
  createdById         String
  createdAt           DateTime           @default(now())
  // Les jeux qui alimentent l'indicateur : un seul pour l'APL de la DREES,
  // un par ARS pour le zonage des médecins.
  sources             IndicatorSource[]
  sections            SectionIndicator[]
  createdBy           User               @relation(fields: [createdById], references: [id])
  observations        Observation[]

  @@map("indicator_definitions")
}

// ── Les versions d'un jeu et leur lecture ───────────────────────────────────
// Un fichier déposé crée une version. L'ancienne n'est jamais écrasée : on
// garde le fichier brut, son empreinte, et chaque ligne telle qu'elle a été lue.

enum VersionState {
  draft // déposée, en cours de description et de contrôle ; une version rejetée y revient
  in_review // soumise à relecture
  preprint // publiée par son seul auteur, étiquetée « prépublication », en attente de relecture
  published // visible du public
  superseded // remplacée par une version publiée plus récente
}

enum ReviewAction {
  submitted
  preprinted
  approved
  rejected
  superseded
}

enum SourceFormat {
  csv
  xlsx
}

enum ImportState {
  uploaded // lu, en attente de description des colonnes
  described // colonnes décrites, pas encore contrôlé
  needs_correction // contrôlé, au moins une anomalie bloquante
  validated // contrôlé sans anomalie bloquante, observations prêtes
}

/**
 * Ce qu'une case dit d'une valeur. Une absence n'est jamais un zéro.
 */
enum ObservationStatus {
  documented // une valeur publiée
  not_documented // case vide, « nd », « - » : le producteur ne donne rien
  confidential // « s » : secret statistique
  not_applicable // « so », « sans objet »
}

enum AnomalySeverity {
  blocking // empêche la validation
  info // se lit, ne bloque pas
}

model DatasetVersion {
  id            String        @id @default(uuid())
  datasetId     String
  // Le millésime annoncé par le producteur : « 2024 », « rentrée 2025 ».
  vintage       String
  // L'adresse exacte du fichier chez le producteur.
  fileUrl       String
  collectedAt   DateTime
  fileName      String
  fileHash      String
  fileSize      Int
  /// L'onglet lu, pour un classeur ; vide pour un CSV.
  sheet         String        @default("")
  state         VersionState  @default(draft)
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  dataset       SourceDataset @relation(fields: [datasetId], references: [id])
  createdBy     User          @relation("VersionCreatedBy", fields: [createdById], references: [id])
  submittedBy   User?         @relation("VersionSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy    User?         @relation("VersionReviewedBy", fields: [reviewedById], references: [id])
  importJob     ImportJob?
  observations  Observation[]

  // Le même fichier ne se dépose pas deux fois pour le même millésime et le même
  // onglet d'un jeu ; un classeur porte plusieurs millésimes (l'APL) ou plusieurs
  // tableaux d'une même année (effectifs et âges moyens des médecins).
  @@unique([datasetId, fileHash, vintage, sheet])
  @@map("dataset_versions")
}

model ImportJob {
  id          String          @id @default(uuid())
  versionId   String          @unique
  format      SourceFormat
  // Les onglets d'un classeur, et celui qui a été lu.
  sheetNames  String[]
  sheet       String?
  // La ligne qui porte les en-têtes, comptée à partir de 1.
  headerRow   Int             @default(1)
  // La description des colonnes : territoire, période, valeurs (voir domain/import-description.ts).
  description Json?
  validatedAt DateTime?
  rowCount    Int
  state       ImportState     @default(uploaded)
  createdAt   DateTime        @default(now())
  version     DatasetVersion  @relation(fields: [versionId], references: [id])
  rows        RawRow[]
  anomalies   ImportAnomaly[]

  @@map("import_jobs")
}

/**
 * Une ligne du fichier telle qu'elle a été lue : des cases de texte, rien d'interprété.
 */
model RawRow {
  jobId     String
  rowNumber Int
  cells     Json
  job       ImportJob @relation(fields: [jobId], references: [id])

  @@id([jobId, rowNumber])
  @@map("raw_rows")
}

model ImportAnomaly {
  id        String          @id @default(uuid())
  jobId     String
  // La ligne du fichier, comptée à partir de 1 ; vide pour une anomalie qui résume une colonne.
  rowNumber Int?
  column    String?
  kind      String
  severity  AnomalySeverity
  message   String
  job       ImportJob       @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("import_anomalies")
}

// ── Les observations ────────────────────────────────────────────────────────
// Une valeur n'existe qu'attachée à un indicateur, un territoire, une période
// et une version. Une absence garde son statut et n'a pas de valeur.

model Observation {
  id            String              @id @default(uuid())
  indicatorId   String
  territoryId   String
  // « 2024 », « 2024-T3 », « 2024-03 », « 2025-2026 » (année scolaire).
  period        String
  value         Decimal?            @db.Decimal(20, 6)
  // Pour un indicateur de catégorie : le code de la catégorie, tel que l'arrêté l'écrit.
  category      String?
  // La date de référence de la valeur, quand le fichier la donne : la date de
  // l'arrêté d'une ARS pour un zonage. Une commune peut être classée par un
  // arrêté plus ancien que sa voisine.
  referenceDate DateTime?           @db.Date
  status        ObservationStatus
  versionId     String
  // La ligne du fichier d'où vient la valeur.
  rowNumber     Int
  indicator     IndicatorDefinition @relation(fields: [indicatorId], references: [id])
  territory     Territory           @relation(fields: [territoryId], references: [id])
  version       DatasetVersion      @relation(fields: [versionId], references: [id])

  @@unique([indicatorId, territoryId, period, versionId])
  @@index([indicatorId, versionId])
  @@map("observations")
}

// ── La revue ────────────────────────────────────────────────────────────────
// Chaque soumission, approbation, rejet ou remplacement laisse une trace
// signée : qui, quand, l'état avant, l'état après, pourquoi. Une trace ne se
// modifie ni ne se supprime.

model ReviewEvent {
  id            String       @id @default(uuid())
  actorId       String
  action        ReviewAction
  // L'objet visé : une version de jeu aujourd'hui, une mesure ou un lien demain.
  subjectType   String
  subjectId     String
  before        Json
  after         Json
  justification String?
  at            DateTime     @default(now())
  actor         User         @relation(fields: [actorId], references: [id])

  @@index([subjectType, subjectId])
  @@map("review_events")
}

/**
 * Un jeu de données qui alimente un indicateur. Le zonage des médecins est un
 * indicateur, alimenté par l'arrêté de chaque ARS ; chacun garde sa
 * provenance, sa licence et ses versions.
 */
model IndicatorSource {
  id            String              @id @default(uuid())
  indicatorId   String
  datasetId     String
  createdById   String
  createdAt     DateTime            @default(now())
  /// Une source retirée ne nourrit plus l'indicateur pour le public ; la ligne
  /// reste, avec qui l'a retirée, quand et pourquoi. Une seule source active
  /// par couple indicateur et jeu (index partiel, voir la migration).
  retiredAt     DateTime?
  retiredById   String?
  retiredReason String?
  indicator     IndicatorDefinition @relation(fields: [indicatorId], references: [id])
  dataset       SourceDataset       @relation(fields: [datasetId], references: [id])
  createdBy     User                @relation("SourceCreatedBy", fields: [createdById], references: [id])
  retiredBy     User?               @relation("SourceRetiredBy", fields: [retiredById], references: [id])

  @@index([indicatorId, datasetId])
  @@map("indicator_sources")
}

// ── Les publications : les enjeux que l'observatoire publie ─────────────────
// Un jeu de données est un matériau, vérifié contre le fichier du producteur.
// Une publication est un enjeu (l'accès aux médecins), lu maillon par
// maillon avec les indicateurs choisis pour chacun. C'est elle qui passe la
// relecture, comme un article de revue, et qui porte une signature.

/// Un enjeu publié. Son adresse (slug) est publique et ne se renomme pas.
model Publication {
  id          String               @id @default(uuid())
  slug        String               @unique
  pillar      Pillar
  createdById String
  createdAt   DateTime             @default(now())
  createdBy   User                 @relation("PublicationCreatedBy", fields: [createdById], references: [id])
  versions    PublicationVersion[]
  /// Les termes surveillés dans les titres des textes déposés au Parlement.
  watchTerms  String[]
  matches     DocumentMatch[]

  @@map("publications")
}

/// Une version d'une publication : son texte et ses maillons. Hors brouillon,
/// elle ne change plus (voir la migration) ; une correction est une nouvelle
/// version.
model PublicationVersion {
  id            String               @id @default(uuid())
  publicationId String
  number        Int
  state         VersionState         @default(draft)
  /// Un titre factuel, sans question ni accroche : « Accès aux médecins
  /// généralistes ».
  title         String
  /// Le chapô : ce que l'enjeu couvre, décrit sans appréciation.
  summary       String
  createdById   String
  createdAt     DateTime             @default(now())
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  publishedAt   DateTime?
  publication   Publication          @relation(fields: [publicationId], references: [id])
  createdBy     User                 @relation("PublicationVersionCreatedBy", fields: [createdById], references: [id])
  submittedBy   User?                @relation("PublicationVersionSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy    User?                @relation("PublicationVersionReviewedBy", fields: [reviewedById], references: [id])
  sections      PublicationSection[]

  @@unique([publicationId, number])
  @@map("publication_versions")
}

/// Un maillon de l'enjeu : « Partir », « S'installer ». Son texte explique
/// ce que le maillon recouvre, sans chiffre qui ne vienne d'un indicateur.
model PublicationSection {
  id         String             @id @default(uuid())
  versionId  String
  position   Int
  title      String
  text       String
  version    PublicationVersion @relation(fields: [versionId], references: [id])
  indicators SectionIndicator[]
  measures   SectionMeasure[]

  @@unique([versionId, position])
  @@map("publication_sections")
}

/// Un indicateur choisi pour un maillon, avec la raison de ce choix : un
/// lien se justifie et passe en revue avec la publication.
model SectionIndicator {
  sectionId     String
  indicatorId   String
  position      Int
  justification String
  section       PublicationSection  @relation(fields: [sectionId], references: [id])
  indicator     IndicatorDefinition @relation(fields: [indicatorId], references: [id])

  @@id([sectionId, indicatorId])
  @@map("section_indicators")
}

// ── Les textes politiques : ce que les formations ont déposé ────────────────
// Une mesure s'affiche par sa citation exacte et son document, avant son
// libellé ; le libellé reformule sans qualifier (CONVENTIONS.md, 1.3 et 1.5).

enum DocumentKind {
  bill // proposition de loi
  government_bill // projet de loi
  law // loi promulguée
  amendment
  programme
}

/// Qui a fait entrer un texte : l'équipe, ou le collecteur automatique.
enum Origin {
  team
  automatic
}

enum Chamber {
  national_assembly
  senate
}

/// Un texte officiel ou un programme, tel que publié par son auteur.
model PoliticalDocument {
  id                String           @id @default(uuid())
  kind              DocumentKind
  title             String
  /// Le numéro du texte dans sa chambre : « 966 », « 494 (2024-2025) ».
  number            String?
  chamber           Chamber?
  filedAt           DateTime         @db.Date
  /// L'adresse du texte lui-même, chez l'Assemblée, le Sénat ou Légifrance.
  url               String
  /// Le premier signataire, ou « Gouvernement » pour un projet de loi.
  firstAuthor       String
  /// Son groupe à la date du dépôt, seulement si une source officielle le dit.
  authorGroup       String?
  authorGroupSource String?
  /// Où en est le texte, en mots et daté : « Adopté par l'Assemblée nationale le 7 mai 2025 ».
  progress          String?
  /// team : saisi par l'équipe ; automatic : collecté sur les données ouvertes du Parlement.
  origin            Origin           @default(team)
  /// La référence du texte chez son producteur (« PIONANR5L17B0966 ») : un texte ne se collecte qu'une fois.
  sourceRef         String?          @unique
  matches           DocumentMatch[]
  /// Le candidat dont c'est le programme, pour un programme électoral.
  candidateId       String?
  candidate         Candidate?       @relation(fields: [candidateId], references: [id])
  createdById       String
  createdAt         DateTime         @default(now())
  createdBy         User             @relation(fields: [createdById], references: [id])
  measures          Measure[]
  /// Pour un programme collecté : l'adresse suivie, l'empreinte SHA-256 du
  /// fichier gardé tel que reçu, et la date de la collecte. Un fichier qui
  /// change chez le candidat entre comme un nouveau document ; l'ancien reste.
  programmeSourceId String?
  programmeSource   ProgrammeSource? @relation(fields: [programmeSourceId], references: [id])
  fileHash          String?
  fetchedAt         DateTime?

  @@map("political_documents")
}

/// Une mesure : un article, sa citation exacte, et un libellé qui reformule.
model Measure {
  id          String            @id @default(uuid())
  documentId  String
  /// « Article 1er »
  article     String
  /// La citation, mot pour mot. Elle ne se réécrit jamais (voir la migration).
  quote       String
  /// L'action, l'objet et l'horizon de la citation, sans adjectif
  /// d'appréciation. Vide pour une mesure collectée automatiquement : elle
  /// n'affiche que son article et sa citation, jusqu'à sa relecture.
  label       String?
  origin      Origin            @default(team)
  /// Le pilier de la proposition, pour la ranger et la comparer.
  pillar      Pillar?
  createdById String
  createdAt   DateTime          @default(now())
  document    PoliticalDocument @relation(fields: [documentId], references: [id])
  createdBy   User              @relation(fields: [createdById], references: [id])
  sections    SectionMeasure[]
  topics      TopicMatch[]

  @@map("measures")
}

/// Une mesure rattachée à un maillon d'une publication, avec la raison du
/// rattachement ; elle passe la relecture avec la publication.
model SectionMeasure {
  sectionId     String
  measureId     String
  position      Int
  justification String
  section       PublicationSection @relation(fields: [sectionId], references: [id])
  measure       Measure            @relation(fields: [measureId], references: [id])

  @@id([sectionId, measureId])
  @@map("section_measures")
}

/// Un texte collecté pour une publication : le terme surveillé qu'il porte.
/// Il s'affiche « collecté automatiquement, non relu » jusqu'à ce que
/// l'équipe en tire des mesures relues.
model DocumentMatch {
  publicationId String
  documentId    String
  term          String
  createdAt     DateTime          @default(now())
  publication   Publication       @relation(fields: [publicationId], references: [id])
  document      PoliticalDocument @relation(fields: [documentId], references: [id])

  @@id([publicationId, documentId])
  @@map("document_matches")
}

// ── Les élections et les candidats ──────────────────────────────────────────
// L'application vulgarise les programmes des candidats : chaque proposition se
// lit en une phrase simple, suivie de sa citation exacte et de sa source.

/// L'état du programme d'un candidat, à la date de vérification.
enum ProgrammeStatus {
  complete // un programme d'ensemble publié
  partial // des documents partiels : livrets, premier volet, contre-budget
  none // rien de publié
}

/// Une élection suivie, avec le critère d'entrée publié, le même pour tous.
model Election {
  id         String      @id @default(uuid())
  slug       String      @unique
  name       String
  /// Le premier tour, s'il est fixé.
  date       DateTime?   @db.Date
  /// « Toute personne qui a déclaré publiquement sa candidature. »
  criterion  String
  candidates Candidate[]

  @@map("elections")
}

/// Un candidat déclaré, et la source de sa déclaration.
model Candidate {
  id                 String              @id @default(uuid())
  electionId         String
  slug               String
  name               String
  /// Le parti ou le mouvement qui le soutient, tel qu'il le nomme.
  party              String
  declaredAt         DateTime            @db.Date
  declarationSource  String
  /// L'adresse de son programme, s'il est publié.
  programmeUrl       String?
  programmeStatus    ProgrammeStatus     @default(none)
  /// Ce que dit la vérification du programme : « édition 2025 », « annoncé, pas encore en ligne ».
  programmeNote      String?
  /// La date de la dernière vérification du programme.
  programmeCheckedAt DateTime?           @db.Date
  /// L'élément Wikidata du candidat (« Q5829 »), vérifié par l'équipe.
  wikidataId         String?
  /// Sa photo sous licence libre, venue de Wikimedia Commons, avec son crédit.
  photoUrl           String?
  photoAuthor        String?
  photoLicence       String?
  photoLicenceUrl    String?
  /// La page du fichier sur Commons.
  photoPage          String?
  photoCheckedAt     DateTime?
  createdById        String
  createdAt          DateTime            @default(now())
  election           Election            @relation(fields: [electionId], references: [id])
  createdBy          User                @relation(fields: [createdById], references: [id])
  documents          PoliticalDocument[]
  programmeSources   ProgrammeSource[]
  videoChannels      VideoChannel[]
  videos             VideoCandidate[]

  @@unique([electionId, slug])
  @@map("candidates")
}

// ── Les sources lues à la demande ──────────────────────────────────────────
// Comme un jeu qui charge le décor autour du joueur : quand une commune
// s'ouvre, l'outil lit ses lignes chez le producteur, sans télécharger le
// fichier entier, et garde la lecture telle qu'il l'a reçue.

/// Une source servie ligne par ligne par son producteur, et la façon de la lire.
model LiveSource {
  id         String        @id @default(uuid())
  slug       String        @unique
  title      String
  producer   String
  pillar     Pillar
  /// La page du jeu chez le producteur, pour le lecteur.
  datasetUrl String
  /// La ressource interrogée ligne par ligne (identifiant data.gouv.fr).
  resourceId String
  license    String
  /// La façon de lire une ligne (voir domain/live-reading.ts).
  layout     Json
  createdAt  DateTime      @default(now())
  readings   LiveReading[]

  @@map("live_sources")
}

/// Une lecture : les lignes d'un territoire, telles que reçues, et leur date.
model LiveReading {
  id                 String     @id @default(uuid())
  sourceId           String
  territoryCode      String
  fetchedAt          DateTime   @default(now())
  /// La date de dernière modification du fichier chez le producteur, à la lecture.
  resourceModifiedAt DateTime?
  rows               Json
  source             LiveSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId, territoryCode, fetchedAt])
  @@map("live_readings")
}

/// Où se lit le programme d'un candidat : une page ou un fichier, et pour une
/// table des matières, le motif des liens à suivre (« /programme/livre/.+ »).
model ProgrammeSource {
  id          String              @id @default(uuid())
  candidateId String
  url         String
  follow      String?
  createdById String
  createdAt   DateTime            @default(now())
  candidate   Candidate           @relation(fields: [candidateId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  documents   PoliticalDocument[]

  @@unique([candidateId, url])
  @@map("programme_sources")
}

/// Un enjeu nommé (« Accès aux médecins généralistes ») et les termes qui le
/// reconnaissent dans les programmes, publiés et les mêmes pour tous.
model Topic {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  pillar      Pillar
  terms       String[]
  createdById String
  createdAt   DateTime     @default(now())
  createdBy   User         @relation(fields: [createdById], references: [id])
  matches     TopicMatch[]

  @@map("topics")
}

/// Un passage de programme rattaché à un enjeu, par le terme trouvé.
model TopicMatch {
  topicId   String
  measureId String
  term      String
  topic     Topic   @relation(fields: [topicId], references: [id])
  measure   Measure @relation(fields: [measureId], references: [id])

  @@id([topicId, measureId])
  @@map("topic_matches")
}

/// La nature d'une chaîne vidéo suivie : celle du candidat, de son parti, ou
/// d'une institution (LCP, Public Sénat, Assemblée nationale, Sénat).
enum ChannelKind {
  candidate
  party
  institution
}

/// Pourquoi une vidéo est rattachée à un candidat.
enum VideoLink {
  own_channel // publiée sur sa propre chaîne
  name_in_title // son nom complet figure dans le titre
}

/// Une chaîne vidéo publique suivie, avec la page officielle qui la cite :
/// seules les sources primaires entrent, sans montage ni commentaire d'un tiers.
model VideoChannel {
  id          String      @id @default(uuid())
  /// L'identifiant de la chaîne chez YouTube : « UCk-_PEY3iC6DIGJKuoEe9bw ».
  youtubeId   String      @unique
  name        String
  kind        ChannelKind
  /// Le candidat de la chaîne (chacune de ses vidéos lui revient), ou celui
  /// que présente le parti (seulement les vidéos qui le nomment).
  candidateId String?
  /// La page officielle d'où vient le lien vers la chaîne.
  linkedFrom  String
  createdById String
  createdAt   DateTime    @default(now())
  candidate   Candidate?  @relation(fields: [candidateId], references: [id])
  createdBy   User        @relation(fields: [createdById], references: [id])
  videos      Video[]

  @@map("video_channels")
}

/// Une vidéo publique, telle que le flux de la chaîne la décrit à sa collecte.
model Video {
  id          String           @id @default(uuid())
  youtubeId   String           @unique
  channelId   String
  title       String
  publishedAt DateTime
  url         String
  thumbnail   String?
  fetchedAt   DateTime         @default(now())
  channel     VideoChannel     @relation(fields: [channelId], references: [id])
  candidates  VideoCandidate[]

  @@map("videos")
}

/// Une vidéo rattachée à un candidat, avec la raison du rattachement.
model VideoCandidate {
  videoId     String
  candidateId String
  link        VideoLink
  video       Video     @relation(fields: [videoId], references: [id])
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@id([videoId, candidateId])
  @@map("video_candidates")
}

/// Une clé d'accès à l'API publique, donnée par l'équipe à un lecteur
/// nommé. Seule son empreinte est gardée ; une clé retirée ne lit plus rien.
model ApiKey {
  id          String    @id @default(uuid())
  /// À qui la clé a été donnée, et pour quel usage.
  label       String
  /// Les premiers signes de la clé, pour la reconnaître sans la garder.
  prefix      String
  keyHash     String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}
